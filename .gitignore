# Cache do Python
__pycache__/
*.pyc

# Arquivos de lock do Excel aberto
~$*.xlsx

# Backups automaticos dos scripts (o git ja versiona; backups sao cinto de seguranca local)
*_backup_*.xlsx

# Dado bruto de obra — decisao de 27/07: o repo compartilhado leva METODO, nao dado.
# Os DXF/DWG do acervo SPHE somam ~1,2 GB e sao do cliente.
*.dxf
*.dwg
*.rvt

# Cache derivado dos extratores (regeravel a partir do DXF, 2-5 MB por obra)
cache_*.json

# gabarito da rodada holdout: e a resposta e e dado da obra - fica local, so o Jose tem
analise-sphe/saida/holdout_*/gabarito_*

# Dado real de obra (Cyrela Joao Dias) - tirado do repo em 04/09, mesma regra do DXF: metodo, nao dado
obras/JOAO_DIAS/
